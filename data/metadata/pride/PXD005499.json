{"accession": "PXD005499", "title": "Analysis of cisplatin exposure on the kidney cortex proteome in the presence and absence of OCT1/2", "additionalAttributes": [], "projectDescription": "WT and mOCT1/2 knockout mice (FVB background) were treated with NaCl or Cisplatin (4 mg/kg bodyweight i.p.) for 4 weeks. The kidneys were perfused and analysed via nLC-MS/MS. Please see the respective manuscript for details.", "sampleProcessingProtocol": "Kidney cortices were homogenized in 8M urea buffer and peptides were reduced, alkylated and cleaned up using stage tips as described in the method section in the respective manuscript.", "dataProcessingProtocol": "Data were processes with MaxQuant/Perseus as described in the method section of the respective manuscript.", "projectTags": ["Biological", "Biomedical"], "keywords": ["Kidney cortex", "Organic cation transporter", "Physiology", "Nephrotoxicity", "Cisplatin", "Kidney"], "doi": "", "submissionType": "PARTIAL", "license": "EBI terms of use", "submissionDate": "2016-12-05", "publicationDate": "2022-02-23", "submitters": [{"title": "Dr", "firstName": "Markus", "lastName": "Rinschen", "identifier": "500105", "affiliation": "Kidney research center cologne", "email": "markus.rinschen@uk-koeln.de", "country": "Germany", "orcid": "0000-0002-9252-1342", "name": "Markus Rinschen", "id": "500105"}], "labPIs": [{"title": "Dr", "firstName": "Giuliano", "lastName": "Ciarimboli", "identifier": "59890100", "affiliation": "University Hospital Muenster", "email": "gciari@uni-muenster.de", "country": "", "orcid": "", "name": "Giuliano Ciarimboli", "id": "59890100"}], "instruments": [{"@type": "CvParam", "cvLabel": "MS", "accession": "MS:1001911", "name": "Q Exactive"}], "softwares": [{"@type": "CvParam", "cvLabel": "MS", "accession": "MS:1001583", "name": "MaxQuant"}], "experimentTypes": [{"@type": "CvParam", "cvLabel": "PRIDE", "accession": "PRIDE:0000429", "name": "Shotgun proteomics"}], "quantificationMethods": [], "countries": ["Germany