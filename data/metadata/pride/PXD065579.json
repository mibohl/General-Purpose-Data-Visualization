{"accession": "PXD065579", "title": "Expanding the global map of protein post translational modifications with PTMScan enrichment and nDIA analysis on the Orbitrap Astral", "additionalAttributes": [], "projectDescription": "The study describes the use of PTMScan enrichment and LC-MS/MS analysis using Orbitrap Astral for the deep coverage of different PTM peptides from cells and tissue.", "sampleProcessingProtocol": "PTMScan workflow was carried out to enrich ubiquitinated, phosphorylated, acetylated, succinylated and mono-methylated PTM peptides from human cell line and mouse tissue and analyzed by DDA and nDIA on the Orbitrap Astral.", "dataProcessingProtocol": "DDA and nDIA data analysis were carried out using MSFragger and Spectronaut software. Graphs were generated using GraphPad PRISM.", "projectTags": [], "keywords": ["Ubiquitination", "Succinylation", "Ptm", "Methylation", "Ptmscan", "Orbitrap astral", "Ndia", "Acetylation", "Mass spec", "Dda", "Phosphorylation"], "doi": "", "submissionType": "PARTIAL", "license": "Creative Commons Public Domain (CC0)", "submissionDate": "2025-06-28", "publicationDate": "2026-05-21", "submitters": [{"title": "Dr", "firstName": "Mukesh", "lastName": "Kumar", "identifier": "3689942", "affiliation": "Cell Signaling Technology", "email": "mukesh.kumar@cellsignal.com", "country": "United States", "orcid": "", "name": "Mukesh Kumar", "id": "3689942"}], "labPIs": [{"title": "Dr", "firstName": "Mukesh", "lastName": "Kumar", "identifier": "3181146", "affiliation": "Cell Signaling Technolgy", "email": "mukesh.kumar@cellsignal.com", "country": "", "orcid": "", "name": "Mukesh Kumar", "id": "3181146"}], "instruments": [{"@type": "CvParam", "cvLabel": "MS", "accession": "MS:1002732", "name": "Orbitrap Fusion Lumos"}, {"@type": "CvParam", "cvLabel": "MS", "accession": "MS:1003378", "name": "Orbitrap Astral"}], "softwares": [{"@type": "CvParam", "cvLabel": "MS", "accession": "MS:1001327", "name": "Spectronaut"}], "experimentTypes": [{"@type