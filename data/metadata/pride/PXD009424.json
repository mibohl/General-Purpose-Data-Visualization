{"accession": "PXD009424", "title": "Fibroblasts grown in 3D -  Three-Dimensional Cell Culture Conditions Affect the Proteome of Cancer-Associated Fibroblasts", "additionalAttributes": [], "projectDescription": "Here, we introduce a 3D cell culture system based on a mixture of collagen I and matrigelTM amenable to stable isotope labeling by amino acids in cell culture and quantitative mass spectrometry-based proteomics analyses. We study the extra- and intracellular proteomic response of skin fibroblast isolated from healthy volunteers in comparison to cancer-associated fibroblasts (CAFs) on 3D culture conditions", "sampleProcessingProtocol": "separation of WCL and ECM by SDS-PAGE and analysis by LC-MS/MS", "dataProcessingProtocol": "MaxQuant 1.4.1.2 was used to process SILAC labeled samples", "projectTags": ["Biomedical"], "keywords": ["Cancer", "Skin", "Lc-ms", "Human", "Fibroblasts"], "doi": "", "submissionType": "PARTIAL", "license": "EBI terms of use", "submissionDate": "2018-04-06", "publicationDate": "2018-09-10", "submitters": [{"title": "Professor", "firstName": "Joern", "lastName": "Dengjel", "identifier": "20700141", "affiliation": "University of Fribourg", "email": "joern.dengjel@medizin.uni-freiburg.de", "country": "Switzerland", "orcid": "0000-0002-9453-4614", "name": "Joern Dengjel", "id": "20700141"}], "labPIs": [{"title": "Dr", "firstName": "Joern", "lastName": "Dengjel", "identifier": "99960100", "affiliation": "Department of Biology, University of Fribourg, Chemin du Mus\u00e9e 10, 1700 Fribourg, Switzerland", "email": "joern.dengjel@unifr.ch", "country": "", "orcid": "", "name": "Joern Dengjel", "id": "99960100"}], "instruments": [{"@type": "CvParam", "cvLabel": "MS", "accession": "MS:1000449", "name": "LTQ Orbitrap"}], "softwares": [{"@type": "CvParam", "cvLabel": "MS", "accession": "MS:1001583", "name": "MaxQuant"}], "experimentTypes": [{"@type": "CvParam", "cvLabel": "PRIDE", "accession": "PRIDE:0000429", "name": "Shotgun proteomics"}, {"@type