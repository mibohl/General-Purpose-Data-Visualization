{"accession": "PXD065651", "title": "Influence of bead chemistry and protein-to-bead ratio on the efficiency of solid-phase proteolysis", "additionalAttributes": [], "projectDescription": "Optimization of an SP3 digestion workflow on human plasma samples. The performance of the SP3 workflow using beads with different surface chemistries (SpeedBeads and MagReSyn beads) was evaluated.", "sampleProcessingProtocol": "Proteins from plasma samples were extracted and digested via SP3 procedures using different beads/proteins ratios in regards to the protein input. Peptides were desalted and analyzed via LC-MS/MS on an exploris 480.", "dataProcessingProtocol": "Raw files were analyzed using DIA-NN 2.0 in library free mode using Swissprot Human as a database.", "projectTags": [], "keywords": ["Sp3", "Plasma", "Digestion"], "doi": "", "submissionType": "PARTIAL", "license": "Creative Commons Public Domain (CC0)", "submissionDate": "2025-07-01", "publicationDate": "2026-02-24", "submitters": [{"title": "Dr", "firstName": "Jean", "lastName": "ARMENGAUD", "identifier": "720123", "affiliation": "Li2D", "email": "jean.armengaud@cea.fr", "country": "France", "orcid": "0000-0003-1589-445X", "name": "Jean ARMENGAUD", "id": "720123"}], "labPIs": [{"title": "Dr", "firstName": "Jean", "lastName": "Armengaud", "identifier": "3181165", "affiliation": "CEA-Marcoule, ProGenoMIX platform, DRF-Li2D", "email": "jean.armengaud@cea.fr", "country": "", "orcid": "", "name": "Jean Armengaud", "id": "3181165"}], "instruments": [{"@type": "CvParam", "cvLabel": "MS", "accession": "MS:1003378", "name": "Orbitrap Astral"}], "softwares": [{"@type": "CvParam", "cvLabel": "MS", "accession": "MS:1003253", "name": "DIA-NN"}], "experimentTypes": [{"@type": "CvParam", "cvLabel": "PRIDE", "accession": "PRIDE:0000450", "name": "Data-independent acquisition"}, {"@type": "CvParam", "cvLabel": "PRIDE", "accession": "PRIDE:0000428", "name": "Bottom-up proteomics"}], "quantificationMethods": [], "countries": ["France